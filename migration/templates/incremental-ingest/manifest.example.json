{
  "manifest_version": 1,
  "streams": [
    {
      "name": "orders",
      "file_glob": "MOCK_orders_batch_*.csv",
      "primary_key": ["order_id"],
      "cursor_column": "updated_at",
      "lookback_seconds": 172800,
      "late_arrival_policy": "quarantine",
      "schema_drift": {
        "on_new_column": "add"
      },
      "max_rejected_rows_per_file": 0,
      "max_future_skew_seconds": 300,
      "columns": [
        {"name": "order_id", "type": "string", "nullable": false},
        {"name": "customer_id", "type": "string", "nullable": false},
        {"name": "order_status", "type": "string", "nullable": false},
        {"name": "order_total", "type": "decimal", "nullable": true},
        {"name": "updated_at", "type": "timestamp", "nullable": false}
      ]
    }
  ]
}
